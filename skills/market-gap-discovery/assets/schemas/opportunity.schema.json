{
  "$id": "opportunity",
  "description": "One opportunity candidate per line in opportunities/candidates.jsonl, generated by `gapscan.py opportunities scan` from the run's own data (method cards D26-D28). Script-made: agents read it, never write it.",
  "type": "object",
  "required": ["opp_id", "lens", "title", "status", "prior", "prior_parts", "base_entities", "why", "needs", "evidence_ids", "flags", "key"],
  "properties": {
    "opp_id": {"type": "string", "pattern": "^OPP-[0-9]{3}$"},
    "lens": {"enum": ["gap", "clone-wedge", "bundle", "unbundle", "port", "down-market", "replace", "hosted-oss", "productize"]},
    "title": {"type": "string", "minLength": 5, "maxLength": 120},
    "status": {"enum": ["candidate", "excluded"]},
    "prior": {"type": "number", "minimum": 0, "maximum": 1},
    "prior_parts": {"type": "object"},
    "category": {"type": ["string", "null"]},
    "category_label": {"type": ["string", "null"]},
    "segment": {"type": ["string", "null"]},
    "base_entities": {"type": "array", "items": {"type": "string"}},
    "base_names": {"type": "array", "items": {"type": "string"}},
    "twist": {"type": ["object", "null"]},
    "pair": {"type": ["array", "null"], "items": {"type": "string"}},
    "why": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "needs": {"type": "array", "items": {"type": "string"}},
    "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^EV-[0-9]{6}$"}},
    "flags": {"type": "array", "items": {"type": "string"}},
    "ambition": {"type": ["object", "null"]},
    "key": {"type": "string", "minLength": 3}
  }
}
