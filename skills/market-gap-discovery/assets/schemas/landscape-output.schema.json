{
  "$id": "landscape-output",
  "description": "One scout's results for landscape, probe or snowball assignments (method cards D03, D04, D05). Each unit is one sampling unit (scout x channel family).",
  "type": "object",
  "required": [
    "assignment_id",
    "scout_id",
    "mode",
    "units",
    "stop_reason",
    "tool_calls"
  ],
  "properties": {
    "assignment_id": {
      "type": "string"
    },
    "scout_id": {
      "type": "string",
      "pattern": "^[A-Z]$"
    },
    "mode": {
      "enum": [
        "landscape",
        "probe",
        "snowball"
      ]
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "unit_id",
          "family",
          "queries",
          "items"
        ],
        "properties": {
          "unit_id": {
            "type": "string"
          },
          "family": {
            "type": "string"
          },
          "stop_reason": {
            "enum": [
              "budget",
              "exhausted",
              "limit",
              "blocked"
            ]
          },
          "queries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "query",
                "source"
              ],
              "properties": {
                "query": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string"
                },
                "results": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "description": "Total hits the source reported for this query (fetch prints 'total hits'); for your own web searches, the number of results you looked at."
                }
              }
            }
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "url",
                "kind"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "url": {
                  "type": "string",
                  "pattern": "^https?://"
                },
                "kind": {
                  "enum": [
                    "product",
                    "community",
                    "directory"
                  ]
                },
                "listing_url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "evidence_url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "query_index": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "via_entity": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "direction": {
                  "enum": [
                    "backward",
                    "forward",
                    null
                  ]
                },
                "note": {
                  "type": "string",
                  "maxLength": 300
                }
              }
            }
          }
        }
      }
    },
    "stop_reason": {
      "enum": [
        "budget",
        "exhausted",
        "limit",
        "blocked"
      ]
    },
    "notes": {
      "type": "string"
    },
    "tool_calls": {
      "type": "integer",
      "minimum": 0
    }
  }
}
