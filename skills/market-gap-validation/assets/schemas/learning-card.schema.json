{
  "$id": "learning-card",
  "description": "Learning Card for one analysed experiment (method card V10).",
  "type": "object",
  "required": [
    "experiment_id",
    "result",
    "we_believed",
    "we_observed",
    "we_learned",
    "therefore",
    "evidence_level"
  ],
  "properties": {
    "experiment_id": {
      "type": "string",
      "pattern": "^EXP-[0-9]{2}$"
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE",
        "TAMPERED"
      ]
    },
    "we_believed": {
      "type": "string",
      "minLength": 10
    },
    "we_observed": {
      "type": "string",
      "minLength": 10
    },
    "we_learned": {
      "type": "string",
      "minLength": 10
    },
    "therefore": {
      "type": "string",
      "minLength": 10
    },
    "evidence_level": {
      "enum": [
        "desk",
        "prototype",
        "interview",
        "survey",
        "click",
        "email",
        "call",
        "loi",
        "deposit",
        "presale"
      ]
    },
    "numbers": {
      "type": "object"
    }
  }
}
